{
  "name": "flylab",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "verify-ids": "pnpm --filter @flylab/sim-core verify",
    "traces": "tsx pipelines/export_traces.ts",
    "bundle": "tsx pipelines/export_client_bundle.ts",
    "lab": "tsx pipelines/export_lab_bundle.ts",
    "export": "pnpm bundle && pnpm traces && pnpm lab",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0"
  }
}
